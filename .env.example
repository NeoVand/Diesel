# Private server credentials. Keep real values in ignored .env/.env.local or host secrets.
OPENAI_API_KEY=
# Shared demo access requires HTTPS, a password of 12+ characters and a signing secret of 32+ characters.
DIESEL_DEMO_PASSWORD=
DIESEL_SESSION_SECRET=
# Guide/narration models are pinned server-side for invited visitors; optional BYOK can override the guide model.
DIESEL_AGENT_MODEL=gpt-6-sol
DIESEL_AUDIO_MODEL=gpt-audio-1.5
# Local development owner access auto-enables only on direct loopback requests with a saved key.
# Set false to disable it. This never grants production access or trusts forwarded localhost headers.
DIESEL_USE_LOCAL_SERVER_KEY=true
# Optional native CAD/FEA interpreters. A project-root .venv-cad/bin/python is auto-detected.
# Set absolute paths for another environment; structural analysis falls back to DESIGN_CAD_PYTHON.
# DESIGN_CAD_PYTHON=/absolute/path/to/python
# DESIGN_STRUCTURAL_PYTHON=/absolute/path/to/python
# Production Node adapter: set the exact browser-visible HTTPS origin, never a visitor-supplied Host.
# ORIGIN=https://diesel.example.com
# Optional trusted server-only path; the SDK normally finds its OS/CPU-matched bundled Codex binary.
# DIESEL_CODEX_PATH=/absolute/path/to/codex
# Optional native callback origin; loopback HTTP pins MCP callbacks to this process behind HTTPS.
# HTTPS remote worker origins are allowed; credentials, paths, query strings and fragments are rejected.
# DIESEL_MCP_ORIGIN=http://127.0.0.1:3000
